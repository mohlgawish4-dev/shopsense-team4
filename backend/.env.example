# PostgreSQL connection string
# Example: postgresql://shopsense_user:shopsense_pass@localhost:5432/shopsense
DATABASE_URL=postgresql://shopsense_user:shopsense_pass@localhost:5432/shopsense

# Secret used to sign JWT access/refresh tokens - use a long random value in production
JWT_SECRET_KEY=change-this-to-a-long-random-secret

# Flask environment: development | production | testing
FLASK_ENV=development

# Flask app secret key (sessions, csrf, etc.)
SECRET_KEY=change-this-too

# JWT access token lifetime in minutes
JWT_ACCESS_TOKEN_EXPIRES_MINUTES=60

# CORS allowed origin(s) for the frontend, comma separated
CORS_ORIGINS=http://localhost:3000
